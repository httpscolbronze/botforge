# BotForge Environment Variables

# Host machine IP (clients fill this in)
HOST_IP=192.168.x.x
HOST_PORT=8000

# Ollama settings
OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=llama3.2
VISION_MODEL=llava

# Optional: Groq API for Speed Mode (internet fallback)
GROQ_API_KEY=your_groq_api_key_here

# Mode: "private" (Ollama local) or "speed" (Groq API)
MODE=private
